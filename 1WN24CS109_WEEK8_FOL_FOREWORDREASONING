
# First Order Logic - Forward Chaining

# Knowledge Base (Facts)
facts = {
    ("American", "Robert"),
    ("Missile", "T1"),
    ("Owns", "A", "T1"),
    ("Enemy", "A", "America")
}

# Rules
rules = [
    # Missiles are weapons
    (["Missile"], "Weapon"),

    # Enemy countries are hostile
    (["Enemy"], "Hostile"),

    # Missiles owned by A are sold by Robert to A
    (["Missile", "Owns"], "Sells"),

    # American selling weapons to hostile nations is criminal
    (["American", "Weapon", "Sells", "Hostile"], "Criminal")
]

# Forward Chaining
changed = True

while changed:
    changed = False

    # Rule 1: Missile -> Weapon
    for fact in list(facts):
        if fact[0] == "Missile":
            new_fact = ("Weapon", fact[1])
            if new_fact not in facts:
                facts.add(new_fact)
                changed = True

    # Rule 2: Enemy -> Hostile
    for fact in list(facts):
        if fact[0] == "Enemy":
            new_fact = ("Hostile", fact[1])
            if new_fact not in facts:
                facts.add(new_fact)
                changed = True

    # Rule 3: Missile and Owns -> Sells
    for missile in list(facts):
        if missile[0] == "Missile":
            for owns in list(facts):
                if owns[0] == "Owns":
                    if missile[1] == owns[2]:
                        new_fact = ("Sells", "Robert",
                                    missile[1], "A")
                        if new_fact not in facts:
                            facts.add(new_fact)
                            changed = True

    # Rule 4: American + Weapon + Sells + Hostile -> Criminal
    for american in list(facts):
        if american[0] == "American":
            for weapon in list(facts):
                if weapon[0] == "Weapon":
                    for sells in list(facts):
                        if sells[0] == "Sells":
                            for hostile in list(facts):
                                if hostile[0] == "Hostile":
                                    if (sells[1] == american[1]
                                        and sells[2] == weapon[1]
                                        and sells[3] == hostile[1]):
                                        new_fact = ("Criminal", american[1])
                                        if new_fact not in facts:
                                            facts.add(new_fact)
                                            changed = True

# Display Knowledge Base
print("Final Knowledge Base:")
for fact in sorted(facts):
    print(fact)

# Query
query = ("Criminal", "Robert")

if query in facts:
    print("\nQuery Proved: Robert is Criminal")
else:
    print("\nQuery Not Proved")
